# Only the website, its screenshots and publishing configuration belong here.
*
!/.gitignore
!/README.md
!/.github/
!/.github/workflows/
!/.github/workflows/pages.yml
!/docs/
!/docs/screenshots/
!/docs/screenshots/*.webp
!/site/
!/site/**/
!/site/**/*.html
!/site/**/*.css
!/site/**/*.js
!/site/**/*.md
!/site/**/*.txt
!/site/**/*.jpg
!/site/**/*.jpeg
!/site/**/*.png
!/site/**/*.webp
!/site/**/*.mp3
!/site/**/*.mp4
!/site/downloads/*-texts.zip
!/site/.nojekyll

# Ignore accidental local or extraction files, even inside allowed directories.
**/.DS_Store
**/._*
**/Thumbs.db
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.apk
**/*.obb
**/*.db
**/*.sqlite*
**/*.csv
**/*.tsv
**/*.log
**/*.tmp
**/__pycache__/
**/.venv/
**/node_modules/
**/.site_work/
**/.research/
